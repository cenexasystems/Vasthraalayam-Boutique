{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth"
    },
    {
      "source": "/api/advance-orders/:id",
      "destination": "/api/advance-orders?id=:id"
    },
    {
      "source": "/api/barcode-registry/lookup/:code",
      "destination": "/api/barcode-registry?action=lookup&code=:code"
    },
    {
      "source": "/api/barcode-registry/:id",
      "destination": "/api/barcode-registry?id=:id"
    },
    {
      "source": "/api/categories/:id",
      "destination": "/api/categories?id=:id"
    },
    {
      "source": "/api/coupons/id/:id",
      "destination": "/api/coupons?id=:id"
    },
    {
      "source": "/api/coupons/:code",
      "destination": "/api/coupons?code=:code"
    },
    {
      "source": "/api/inventory/adjust",
      "destination": "/api/inventory?action=adjust"
    },
    {
      "source": "/api/inventory/receive",
      "destination": "/api/inventory?action=receive"
    },
    {
      "source": "/api/orders/:id",
      "destination": "/api/orders?id=:id"
    },
    {
      "source": "/api/products/:id",
      "destination": "/api/products?id=:id"
    },
    {
      "source": "/api/settings/password",
      "destination": "/api/settings?action=password"
    },
    {
      "source": "/api/variants/:id",
      "destination": "/api/variants?id=:id"
    },
    {
      "source": "/((?!api/|assets/|favicon|robots|vasthraalayam|manifest|sw|workbox|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ]
}
